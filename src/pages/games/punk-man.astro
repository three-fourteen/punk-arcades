---
import Site from '../../layouts/Site.astro';
---
<Site title="Punk-man: Escape Riot" description="Collect 30 charges, improvise your way past corporate ghost-drones, and escape before lockdown. A free keyboard and touch arcade game.">
  <div class="wrap game-page">
    <div class="breadcrumb mono"><a href="/">← The arcade</a><span>Game 001 / Maze escape</span></div>
    <div class="game-heading"><div><div class="eyebrow mono">A little corporate sabotage.</div><h1>PUNK—MAN<span>ESCAPE RIOT</span></h1></div><div class="edition mono"><span class="dot"></span> First playable<br/><span class="muted">One maze. One way out.</span></div></div>
    <div class="game-layout" id="game-shell">
      <section class="cabinet" aria-label="Punk-man game">
        <div class="hud"><div><span class="mono muted">Score</span><strong id="score">000000</strong></div><div><span class="mono muted">Charges</span><strong><span id="charges">00</span><small> / 30</small></strong></div><div><span class="mono muted">Integrity</span><strong id="health" aria-label="3 of 3 integrity">▰▰▰</strong></div><div class="hud-exit"><span class="mono muted" id="phase-label">Exit sealed</span><strong id="timer">— : —</strong></div></div>
        <div class="arena" id="arena" tabindex="0" role="group" aria-label="Maze game. Arrow keys or W A S D to move. Space to fire. Q to switch weapon. P or Escape to pause." aria-describedby="objective">
          <div id="game-canvas" aria-hidden="true"></div>
          <div class="game-overlay" id="overlay">
            <span class="overlay-stamp mono" id="overlay-kicker">Unauthorized access</span>
            <h2 id="overlay-title">START A RIOT.</h2>
            <p id="overlay-copy">Steal 30 charges. Unlock the exit.<br/>Get out before the city locks down.</p>
            <button class="button" id="start" disabled>Loading the maze…</button>
            <span class="mono overlay-hint" id="overlay-hint">WASD / Arrows to move · Space to fire</span>
          </div>
        </div>
        <div class="game-toolbar"><span class="mono" id="live-message" role="status" aria-live="polite">Find a route. Make some trouble.</span><div><button id="pause" type="button" aria-label="Pause game" disabled>Ⅱ</button><button id="sound" type="button" aria-pressed="false">Sound on</button></div></div>
        <div class="touch-controls" aria-label="Touch controls"><div class="stick" id="stick" role="group" aria-label="Virtual movement stick"><span aria-hidden="true">↑</span><div><span aria-hidden="true">←</span><span class="stick-knob" aria-hidden="true"></span><span aria-hidden="true">→</span></div><span aria-hidden="true">↓</span></div><div class="touch-actions"><button id="touch-switch" class="touch-switch" aria-label="Switch weapon">⇄<span>SWITCH</span></button><button id="touch-fire" class="touch-fire">↯<span>FIRE</span></button></div></div>
        <noscript>This game requires JavaScript. Enable it and reload to play.</noscript>
      </section>
      <aside class="field-guide">
        <section><div class="guide-label mono"><span>01 / The job</span><span>↗</span></div><h2>TAKE THE POWER.<br/>THEN RUN.</h2><p id="objective">Collect <b>30 charges</b> to open the exit <b>↗ in the top-right corner</b>. The alarm gives you <b>45 seconds</b> to escape. You have three hits.</p><div class="objective-line"><span class="charge-icon">▮</span><span class="mono">Charges stolen</span><strong id="progress-label">0 / 30</strong></div><progress id="progress" max="30" value="0" aria-label="Charges collected"></progress></section>
        <section><div class="guide-label mono"><span>02 / Make a little room</span><span id="ammo-label">1 shot</span></div><div class="weapons" aria-label="Select weapon"><button class="weapon selected" data-weapon="pulse" aria-pressed="true"><span class="weapon-icon">◎</span><span><b>EMP pulse</b><small>Stun nearby drones</small></span><kbd>1</kbd><strong id="ammo-pulse">1</strong></button><button class="weapon" data-weapon="bolt" aria-pressed="false"><span class="weapon-icon">ϟ</span><span><b>Scrap bolt</b><small>Clear a straight corridor</small></span><kbd>2</kbd><strong id="ammo-bolt">0</strong></button><button class="weapon" data-weapon="shove" aria-pressed="false"><span class="weapon-icon">»</span><span><b>Ram blast</b><small>Push back, buy time</small></span><kbd>3</kbd><strong id="ammo-shove">0</strong></button></div><div class="jaw-note"><span>▤</span><p><b id="jaw-label">The robotic jaw</b><br/>Rare pickup. Eight seconds to consume drones on contact. +2 charges per bite.</p></div></section>
        <section><div class="guide-label mono"><span>03 / Know your enemies</span></div><div class="enemy"><span class="drone red">▪▪</span><p><b>Tracker</b><span>Follows you. Relentlessly.</span></p></div><div class="enemy"><span class="drone cyan">▪▪</span><p><b>Interceptor</b><span>Aims for where you’re going.</span></p></div><div class="enemy"><span class="drone purple">▪▪</span><p><b>Warden</b><span>Slow. Territorial. In the way.</span></p></div></section>
      </aside>
    </div>
    <section class="controls-guide"><h2 class="mono">Your tools of dissent</h2><div><span><kbd>W A S D</kbd> / <kbd>↑ ← ↓ →</kbd> Move</span><span><kbd>SPACE</kbd> Fire</span><span><kbd>Q</kbd> Switch weapon</span><span><kbd>P</kbd> / <kbd>ESC</kbd> Pause</span><span class="muted">Touch? Use the stick + buttons below the maze.</span></div><p class="muted">Tap a direction to keep moving. Turns queue until the next opening. Cyan crates give two shots. A pulse reaches through walls; bolts and ram blasts don’t.</p></section>
  </div>
</Site>
<script>
  import '../../games/punk-man/controller';
</script>
<style>
.game-page{max-width:1300px}.breadcrumb{display:flex;justify-content:space-between;color:var(--muted);padding:28px 0}.breadcrumb a:hover{color:var(--acid)}.game-heading{display:flex;justify-content:space-between;align-items:center;margin:8px 0 28px}.game-heading .eyebrow{font-size:10px;margin-bottom:12px}h1{font-size:52px;letter-spacing:-3px;font-weight:950;line-height:1;margin:0}h1 span{font-size:13px;letter-spacing:.28em;margin-left:20px;color:var(--acid)}.edition{color:var(--acid);text-align:right;line-height:2}.game-layout{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:32px;align-items:start}.cabinet{border:1px solid #465035;background:#0c1109;min-width:0}.hud{display:flex;justify-content:space-between;padding:18px 22px;border-bottom:1px solid #465035;background:#1b2115;gap:8px}.hud>div{display:flex;flex-direction:column;gap:7px}.hud .mono{font-size:9px}.hud strong{font-family:'Courier New',monospace;font-size:23px;font-weight:700;letter-spacing:.03em}.hud small{color:var(--muted);font-size:14px}#health{color:var(--acid);letter-spacing:4px}.hud-exit{text-align:right}.arena{position:relative;aspect-ratio:672/608;width:100%;overflow:hidden}.arena:focus-visible{outline-offset:-3px}#game-canvas{position:absolute;inset:0}#game-canvas :global(canvas){display:block}.game-overlay{position:absolute;inset:0;background:rgba(10,16,7,.88);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:20px}.game-overlay[hidden]{display:none}.overlay-stamp{color:var(--acid);border:1px solid #596e2c;padding:8px 12px;transform:rotate(-3deg);font-size:10px}.game-overlay h2{font-size:clamp(30px,4vw,54px);font-weight:950;letter-spacing:-.06em;margin:24px 0 12px}.game-overlay p{color:#c0c7b2;font-size:14px;margin-bottom:24px;max-width:330px}.overlay-hint{color:var(--muted);font-size:9px;margin-top:20px}.game-toolbar{border-top:1px solid #465035;display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:54px;padding:8px 16px}.game-toolbar>span{font-size:9px;letter-spacing:.02em;color:var(--acid);line-height:1.5}.game-toolbar>div{display:flex;flex-shrink:0;gap:4px}.game-toolbar button{background:transparent;border:1px solid #36412b;color:var(--paper);font-family:'Courier New',monospace;font-size:10px;padding:10px;min-height:36px}.field-guide section{border-top:1px solid var(--line);padding-top:18px;margin-bottom:26px}.guide-label{font-size:9px;display:flex;justify-content:space-between;color:var(--muted);margin-bottom:20px}.field-guide h2{font-size:25px;letter-spacing:-1px;line-height:1.1;margin-bottom:14px}.field-guide p{font-size:12px;color:var(--muted);line-height:1.65}.field-guide p b{color:var(--paper);font-weight:400}.objective-line{display:flex;align-items:center;gap:10px;margin-top:20px}.charge-icon{color:var(--acid);font-size:21px}.objective-line .mono{font-size:9px;color:var(--muted)}.objective-line strong{margin-left:auto;font-size:11px;font-family:monospace}progress{appearance:none;display:block;width:100%;height:4px;border:0;margin-top:8px;background:#303628}progress::-webkit-progress-bar{background:#303628}progress::-webkit-progress-value{background:var(--acid)}progress::-moz-progress-bar{background:var(--acid)}.weapons{display:grid;gap:6px}.weapon{display:flex;align-items:center;gap:12px;width:100%;text-align:left;background:transparent;color:var(--paper);border:1px solid var(--line);padding:10px}.weapon.selected{border-color:#75883a;background:#242d17}.weapon-icon{font-size:26px;color:var(--acid);width:24px;text-align:center}.weapon b{font-size:12px;display:block}.weapon small{display:block;color:var(--muted);font-size:10px;margin-top:4px}.weapon kbd{margin-left:auto;font-size:9px}.weapon strong{font-size:14px;color:var(--acid)}kbd{font-family:'Courier New',monospace;font-size:10px;border:1px solid #4c5142;padding:3px 5px;border-radius:3px;color:var(--paper)}.jaw-note{display:flex;gap:12px;margin-top:16px}.jaw-note>span{color:#f4e3a1;font-size:24px}.jaw-note p{font-size:10px;margin:0}.enemy{display:flex;align-items:center;gap:12px;margin-bottom:12px}.enemy p{margin:0;line-height:1.5}.enemy p b{font-size:11px;display:block}.enemy p span{font-size:10px}.drone{width:25px;height:26px;border-radius:12px 12px 2px 2px;display:grid;place-items:center;font-weight:bold;color:#111;font-size:15px;letter-spacing:1px}.red{background:var(--red)}.cyan{background:var(--cyan)}.purple{background:#b69be8}.controls-guide{border-top:1px solid var(--line);padding-top:24px;margin-top:32px}.controls-guide h2{font-size:10px;color:var(--acid);margin-bottom:20px}.controls-guide>div{display:flex;gap:24px;flex-wrap:wrap;font-size:11px;align-items:center}.controls-guide>div>span{display:flex;gap:8px;align-items:center}.controls-guide p{font-size:11px;margin-top:20px}.touch-controls{display:none;justify-content:space-between;align-items:center;padding:18px 24px;border-top:1px solid #36412b;touch-action:none}.stick{width:110px;height:110px;border:1px solid #56653d;border-radius:50%;background:#202a16;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--muted);touch-action:none;user-select:none}.stick>div{display:flex;gap:12px;align-items:center}.stick-knob{width:34px;height:34px;background:#56673a;border:1px solid #819650;border-radius:50%;transition:transform 80ms linear,background-color 80ms linear}.stick.active .stick-knob{background:var(--acid);border-color:var(--acid)}.touch-actions{display:flex;gap:16px;align-items:center}.touch-actions button{border-radius:50%;width:62px;height:62px;border:1px solid #56653d;background:#202a16;color:var(--paper);font-size:24px;touch-action:none}.touch-actions button span{display:block;font-size:8px;letter-spacing:.1em}.touch-actions .touch-fire{width:78px;height:78px;background:var(--acid);color:var(--ink);font-size:30px}@media(pointer:coarse){.touch-controls{display:flex}}@media(max-width:1000px){.game-layout{grid-template-columns:minmax(0,1fr) 240px;gap:20px}h1{font-size:40px}h1 span{font-size:10px;margin-left:12px}.edition{display:none}.hud{padding:14px}.hud strong{font-size:20px}.game-overlay h2{font-size:36px}}@media(max-width:760px){.game-layout{grid-template-columns:1fr}.field-guide{display:grid;grid-template-columns:1fr 1fr;gap:24px}.field-guide section{margin:0}.field-guide section:first-child{grid-column:1/-1}.field-guide h2 br{display:none}.touch-controls{display:flex}.game-heading{margin:8px 0 24px}h1{font-size:46px}h1 span{display:block;margin:10px 0 0;font-size:11px}.game-overlay h2{font-size:42px}.breadcrumb{font-size:9px}.controls-guide{margin-top:28px}.hud strong{font-size:21px}}@media(max-width:420px){.hud{padding:12px 10px}.hud strong{font-size:17px}.hud small{font-size:11px}.hud .mono{font-size:8px}#health{letter-spacing:1px}.game-overlay h2{font-size:32px;margin-top:16px}.game-overlay p{font-size:12px;margin-bottom:16px}.overlay-hint{font-size:7px;margin-top:14px}.game-overlay .button{min-height:44px}.overlay-stamp{font-size:8px}.field-guide{grid-template-columns:1fr}.field-guide section:first-child{grid-column:auto}.game-toolbar{padding:8px}.game-toolbar>span{font-size:8px}.touch-controls{padding:16px}.stick{width:96px;height:96px}}
@media(pointer:coarse){
:global(body.game-active) .breadcrumb,:global(body.game-active) .game-heading{display:none}
:global(body.game-active .site-header){height:auto;padding:8px 0}
:global(body.game-active .site-header) :global(.brand){font-size:13px;gap:8px}
:global(body.game-active .site-header) :global(.brand-mark){width:22px;height:22px;font-size:17px}
:global(body.game-active .site-header) :global(nav){gap:12px;font-size:9px}
}
@media(pointer:coarse) and (max-height:500px){.arena{width:auto;height:min(36vh,240px);margin:0 auto}.hud{padding:6px 10px}.hud strong{font-size:14px}.hud small{font-size:10px}.game-toolbar{min-height:auto;padding:4px 10px}.game-toolbar button{padding:6px;min-height:28px}.touch-controls{padding:8px 14px}.stick{width:72px;height:72px}.touch-actions{gap:10px}.touch-actions button{width:44px;height:44px;font-size:16px}.touch-actions .touch-fire{width:54px;height:54px;font-size:20px}}
</style>
