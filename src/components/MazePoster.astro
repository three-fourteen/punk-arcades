---
import { MAZE } from '../games/punk-man/map';
---
<svg viewBox="0 0 672 608" role="img" aria-label="Industrial maze with a yellow punk and three corporate ghost-drones">
  <defs><pattern id="grid" width="32" height="32" patternUnits="userSpaceOnUse"><path d="M32 0H0V32" fill="none" stroke="#22291b" stroke-width=".5"/></pattern></defs>
  <rect width="672" height="608" fill="#10170d"/><rect width="672" height="608" fill="url(#grid)"/>
  {MAZE.map((row,y)=>[...row].map((c,x)=>c==='#' ? <g><rect x={x*32+3} y={y*32+3} width="26" height="26" rx="3" fill="#1f2b18" stroke="#6f8731" stroke-width="1"/><path d={`M${x*32+8} ${y*32+8}h8`} stroke="#9faf48" opacity=".4"/></g> : c==='.' && (x+y)%2===0 ? <rect x={x*32+14} y={y*32+14} width="4" height="4" fill="#d7f542"/> : null))}
  <g transform="translate(240 304) rotate(-12) scale(2.4)">
    <circle r="10" fill="#d7f542"/>
    <path d="M-10-5L-11-12-7-10-8-16-4-13-3-19 0-14 3-19 5-13 9-16 9-9 5-7-4-7Z" fill="#ef3e45"/>
    <path d="M-8-9L-5-12-2-11 1-14 4-11 7-12 6-8-4-7Z" fill="#ff7864"/>
    <path d="M1-5h9v4H1z" fill="#10170e"/><path d="M6-4h2v2H6z" fill="#f5ffca"/>
    <path d="M-4 0H11L12 5 7 11-3 10-7 5Z" fill="#10170e"/>
    <path d="M0 1h11v2H0zM1 2h2v2H1zM5 2h2v2H5zM9 2h2v2H9z" fill="#f0f2dc"/>
    <path d="M-6 2L-3 3-2 7H8L11 5V9L6 12-3 11-7 6Z" fill="#9aa9a5"/>
    <path d="M-2 8H8L10 7 8 10H0Z" fill="#e0e8df"/>
    <path d="M0 5h2v3H0zM4 5h2v3H4zM8 5h2v3H8z" fill="#f0f2dc"/>
    <circle cx="-5" cy="3" r="3" fill="#526662"/><circle cx="-5" cy="3" r="1.2" fill="#e0e8df"/>
  </g>
  <g transform="translate(464 240)"><path d="M-19 21V0a19 19 0 0 1 38 0v21l-9-6-10 6-10-6z" fill="#ed7358"/><rect x="-14" y="-5" width="28" height="13" rx="3" fill="#171a14"/><path d="M-8-2v7m12-7v7" stroke="#fff4cf" stroke-width="5"/><path d="M0-20v-8m-4 0h8" stroke="#ed7358" stroke-width="3"/></g>
  <g transform="translate(144 464)"><path d="M-17 20V0a17 17 0 0 1 34 0v20l-8-5-9 5-9-5z" fill="#70dacd"/><rect x="-12" y="-4" width="24" height="11" fill="#171a14"/><path d="M-7-2v6m12-6v6" stroke="#e8ffeb" stroke-width="4"/></g>
  <g transform="translate(528 496)"><path d="M-20 20V0a20 20 0 0 1 40 0v20l-10-5-10 5-10-5z" fill="#b69be8"/><rect x="-14" y="-6" width="28" height="12" fill="#171a14"/><path d="M-8-2v6m12-6v6" stroke="#f2e5ff" stroke-width="5"/></g>
  <g transform="translate(624 48)"><rect x="-14" y="-14" width="28" height="28" fill="#d7f542"/><path d="M-8 0H8M2-6l6 6-6 6" stroke="#171a14" stroke-width="3" fill="none"/></g>
</svg>
